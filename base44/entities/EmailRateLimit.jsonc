{
  "name": "EmailRateLimit",
  "type": "object",
  "properties": {
    "rate_key": {
      "type": "string",
      "description": "Key the attempts are counted against (IP, email, user id or a global key)"
    },
    "last_sent": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last action for this key"
    },
    "attempts": {
      "type": "number",
      "default": 0,
      "description": "Number of actions counted in the current window"
    },
    "window_start": {
      "type": "string",
      "format": "date-time",
      "description": "When the current counting window started"
    }
  },
  "required": [
    "rate_key",
    "last_sent"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}